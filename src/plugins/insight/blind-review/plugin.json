{
  "id": "blind-review",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "盲审",
  "description": "代码审查面板",
  "tags": [
    "review"
  ],
  "renderer": "./renderer/index.tsx",
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "fileActions": [
      {
        "id": "blindReviewFile",
        "labelKey": "review.fileAction",
        "icon": "eye-off",
        "when": {
          "target": "file"
        }
      }
    ],
    "settings": [
      {
        "id": "blind-review",
        "title": "盲审",
        "icon": "eye-off",
        "component": "BlindReviewSettings",
        "configFile": "~/.my-harness-desktop/config/blind-review.json",
        "configMerge": "deep",
        "saveMode": "framework",
        "order": 8
      }
    ],
    "sidePanel": [
      {
        "id": "blind-review",
        "label": "盲审",
        "icon": "eye-off",
        "component": "BlindReviewTab",
        "order": 15
      }
    ],
    "languages": [
      {
        "id": "blind-review.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      },
      {
        "id": "blind-review.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "blind-review.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "blind-review.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "blind-review.review",
        "locale": "de",
        "resources": "./locales/de/review.json"
      },
      {
        "id": "blind-review.review",
        "locale": "en",
        "resources": "./locales/en/review.json"
      },
      {
        "id": "blind-review.review",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/review.json"
      },
      {
        "id": "blind-review.review",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/review.json"
      },
      {
        "id": "blind-review.settings",
        "locale": "de",
        "resources": "./locales/de/settings.json"
      },
      {
        "id": "blind-review.settings",
