{
  "id": "file-tree",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "文件",
  "description": "右面板文件树,浏览项目目录结构,点击用系统默认应用打开文件",
  "tags": [
    "project"
  ],
  "renderer": "./renderer/index.tsx",
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "sidePanel": [
      {
        "id": "files",
        "label": "文件",
        "icon": "folder-open",
        "component": "FileTreeTab",
        "order": 30
      }
    ],
    "fileIcons": [
      { "id": "ts", "icon": "file-code", "color": "#3178c6", "extensions": ["ts", "tsx", "mts", "cts"] },
      { "id": "js", "icon": "file-code", "color": "#d8b53a", "extensions": ["js", "jsx", "mjs", "cjs"] },
      { "id": "py", "icon": "file-code", "color": "#3572a5", "extensions": ["py", "pyi"] },
      { "id": "rust", "icon": "file-code", "color": "#dea584", "extensions": ["rs"] },
      { "id": "go", "icon": "file-code", "color": "#00add8", "extensions": ["go"] },
      { "id": "jvm", "icon": "file-code", "color": "#b07219", "extensions": ["java", "kt", "kts", "scala", "groovy"] },
      { "id": "native", "icon": "file-code", "color": "#659ad2", "extensions": ["c", "h", "cpp", "cxx", "cc", "hpp"] },
      { "id": "code-other", "icon": "file-code", "extensions": ["rb", "php", "lua", "swift", "dart", "vue", "svelte", "astro", "cs", "r", "jl", "ex", "exs", "erl", "hs", "ml"] },
      { "id": "json", "icon": "file-json", "color": "#cbcb41", "extensions": ["json", "jsonc", "json5"] },
      { "id": "notebook", "icon": "file-json", "color": "#f37726", "extensions": ["ipynb"] },
      { "id": "config", "icon": "file-cog", "color": "#9ca3af", "extensions": ["yaml", "yml", "toml", "ini", "cfg", "conf", "env", "properties", "editorconfig"] },
      { "id": "style", "icon": "file-code", "color": "#2965f1", "extensions": ["css", "scss", "sass", "less", "styl"] },
      { "id": "web", "icon": "file-code", "color": "#e34c26", "extensions": ["html", "htm", "xml", "xhtml"] },
      { "id": "markdown", "icon": "file-text", "color": "#519aba", "extensions": ["md", "mdx", "markdown"] },
      { "id": "text", "icon": "file-text", "extensions": ["txt", "log", "rst", "adoc"] },
      { "id": "shell", "icon": "file-terminal", "color": "#4eaa25", "extensions": ["sh", "bash", "zsh", "fish", "ps1", "bat", "cmd"] },
      { "id": "db", "icon": "database", "color": "#d97706", "extensions": ["sql", "sqlite", "sqlite3", "db"] },
      { "id": "api-schema", "icon": "file-code", "color": "#e535ab", "extensions": ["graphql", "gql", "proto"] },
      { "id": "image", "icon": "file-image", "color": "#a074c4", "extensions": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "ico", "tiff", "svg"] },
      { "id": "video", "icon": "file-video", "color": "#fd971f", "extensions": ["mp4", "mov", "webm", "mkv", "avi"] },
      { "id": "audio", "icon": "file-audio", "color": "#4ec9b0", "extensions": ["mp3", "wav", "flac", "ogg", "m4a", "aac"] },
      { "id": "archive", "icon": "file-archive", "color": "#b58900", "extensions": ["zip", "gz", "tar", "rar", "7z", "xz", "bz2", "dmg", "iso"] },
      { "id": "pdf", "icon": "file-text", "color": "#cc3e44", "extensions": ["pdf"] },
      { "id": "office-doc", "icon": "file-type", "color": "#2b579a", "extensions": ["doc", "docx", "odt", "rtf", "pages"] },
      { "id": "sheet", "icon": "file-spreadsheet", "color": "#217346", "extensions": ["xls", "xlsx", "csv", "tsv", "ods", "numbers"] },
      { "id": "slides", "icon": "file-pie-chart", "color": "#d24726", "extensions": ["ppt", "pptx", "key", "odp"] },
      { "id": "binary", "icon": "binary", "color": "#8b949e", "extensions": ["exe", "dll", "so", "dylib", "bin", "app", "node", "wasm", "dat"] },
      { "id": "key", "icon": "file-key", "color": "#d4a72c", "extensions": ["pem", "key", "crt", "cer", "p12", "pfx"] },
      { "id": "font", "icon": "file-type", "color": "#b07219", "extensions": ["ttf", "otf", "woff", "woff2", "eot"] },
      { "id": "lock", "icon": "file-lock", "color": "#d4a72c", "extensions": ["lock"] },
      { "id": "docker", "icon": "container", "color": "#0db7ed", "filenames": ["dockerfile", "containerfile", ".dockerignore"] },
      { "id": "git-files", "icon": "git-branch", "color": "#f14e32", "filenames": [".gitignore", ".gitattributes", ".gitmodules", ".gitkeep"] },
      { "id": "lockfiles", "icon": "file-lock", "color": "#d4a72c", "filenames": ["package-lock.json", "yarn.lock", "pnpm-lock.yaml", "cargo.lock", "gemfile.lock", "composer.lock", "poetry.lock", "bun.lockb"] },
      { "id": "build-files", "icon": "wrench", "filenames": ["makefile", "gnumakefile", "cmakelists.txt", "justfile"] },
      { "id": "docs-files", "icon": "book-open", "color": "#519aba", "filenames": ["readme", "readme.md", "readme.txt", "changelog", "changelog.md", "license", "license.md", "copying", "notice", "authors"] }
    ],
    "languages": [
      {
        "id": "file-tree.files",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "en",
        "resources": "./locales/en/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "de",
        "resources": "./locales/de/files.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
