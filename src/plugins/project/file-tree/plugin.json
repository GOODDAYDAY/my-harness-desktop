{
  "id": "file-tree",
  "version": "0.1.0",
  "displayName": "文件",
  "description": "右面板文件树,浏览项目目录结构,点击用系统默认应用打开文件",
  "tags": [
    "project"
  ],
  "renderer": "./renderer/index.tsx",
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "sidePanel": [
      {
        "id": "files",
        "label": "文件",
        "icon": "folder-open",
        "component": "FileTreeTab",
        "order": 30
      }
    ],
    "languages": [
      {
        "id": "file-tree.files",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "en",
        "resources": "./locales/en/files.json"
      },
      {
        "id": "file-tree.files",
        "locale": "de",
        "resources": "./locales/de/files.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "file-tree.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
