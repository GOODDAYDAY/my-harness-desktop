{
  "id": "theme-chatgpt",
  "version": "0.1.0",
  "displayName": "ChatGPT Theme",
  "tokenSchemaVersion": "^1.0",
  "contributes": {
    "themes": [
      {
        "id": "chatgpt-dark",
        "name": "ChatGPT Dark",
        "base": "dark",
        "tokens": {
          "color.bg": "#212121",
          "color.fg": "#ececec",
          "color.surface": "#2f2f2f",
          "color.surface-fg": "#ececec",
          "color.primary": "#ececec",
          "color.primary-fg": "#212121",
          "color.accent.success": "#34d399",
          "color.accent.warning": "#facc15",
          "color.accent.error": "#f87171",
          "color.accent.danger": "#f87171",
          "color.border": "rgba(255,255,255,0.08)",
          "color.muted": "#9b9b9b",
          "font.size.base": "16px",
          "font.size.sm": "13px",
          "font.size.lg": "20px",
          "radius.sm": "8px",
          "radius.md": "12px",
          "radius.lg": "16px",
          "shadow.sm": "0 1px 2px rgba(0,0,0,0.2)",
          "shadow.md": "0 4px 16px rgba(0,0,0,0.3)",
          "shadow.lg": "0 8px 32px rgba(0,0,0,0.4)"
        }
      }
    ]
  }
}
