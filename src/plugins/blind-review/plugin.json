{
  "id": "blind-review",
  "version": "0.1.0",
  "displayName": "盲审",
  "description": "代码审查面板",
  "tags": [
    "review"
  ],
  "renderer": "./renderer/index.tsx",
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "fileActions": [
      {
        "id": "blindReviewFile",
        "labelKey": "review.fileAction",
        "icon": "eye-off",
        "when": {
          "target": "file"
        }
      }
    ],
    "settings": [
      {
        "id": "blind-review",
        "title": "盲审",
        "icon": "eye-off",
        "component": "BlindReviewSettings",
        "configFile": "~/.pi-desktop/config/blind-review.json",
        "configMerge": "deep",
        "saveMode": "framework",
        "order": 8
      }
    ],
    "sidePanel": [
      {
        "id": "blind-review",
        "label": "盲审",
        "icon": "eye-off",
        "component": "BlindReviewTab",
        "order": 15
      }
    ]
  }
}
