{
  "id": "general-config",
  "version": "0.4.9",
  "displayName": "通用配置",
  "description": "桌面端通用配置",
  "contributes": {
    "settings": [
      {
        "id": "general",
        "title": "通用",
        "icon": "settings",
        "component": "GeneralConfigPage",
        "configFile": "~/.pi-desktop/config/general.json",
        "configMerge": "deep",
        "order": 1
      }
    ],
    "settingsGroups": [
      {
        "id": "interface",
        "titleKey": "settings.groupInterface",
        "order": 20,
        "fields": [
          { "key": "sidebarDefaultOpen", "type": "boolean", "default": false, "titleKey": "settings.sidebarDefaultOpen", "descKey": "settings.sidebarDefaultOpenDesc" },
          { "key": "floatCard", "type": "boolean", "default": true, "titleKey": "settings.floatCard", "descKey": "settings.floatCardDesc" }
        ]
      }
    ],
    "languages": [
      {
        "id": "general-config.settings",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/settings.json"
      },
      {
        "id": "general-config.settings",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/settings.json"
      },
      {
        "id": "general-config.settings",
        "locale": "en",
        "resources": "./locales/en/settings.json"
      },
      {
        "id": "general-config.settings",
        "locale": "de",
        "resources": "./locales/de/settings.json"
      },
      {
        "id": "general-config.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "general-config.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "general-config.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "general-config.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
