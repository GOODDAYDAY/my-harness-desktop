{
  "id": "i18n",
  "version": "0.9.0",
  "displayName": "国际化",
  "description": "pi-desktop 语言槽插件,贡献简体/繁体/英/德四语言文案 + 语言设置页",
  "renderer": "renderer/index.tsx",
  "protected": true,
  "contributes": {
    "languages": [
      {
        "id": "i18n.common",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/common.json"
      },
      {
        "id": "i18n.settings",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/settings.json"
      },
      {
        "id": "i18n.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "i18n.common",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/common.json"
      },
      {
        "id": "i18n.settings",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/settings.json"
      },
      {
        "id": "i18n.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "i18n.common",
        "locale": "en",
        "resources": "./locales/en/common.json"
      },
      {
        "id": "i18n.settings",
        "locale": "en",
        "resources": "./locales/en/settings.json"
      },
      {
        "id": "i18n.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "i18n.common",
        "locale": "de",
        "resources": "./locales/de/common.json"
      },
      {
        "id": "i18n.settings",
        "locale": "de",
        "resources": "./locales/de/settings.json"
      },
      {
        "id": "i18n.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      },
      {
        "id": "i18n.shell",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/shell.json"
      },
      {
        "id": "i18n.shell",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/shell.json"
      },
      {
        "id": "i18n.shell",
        "locale": "en",
        "resources": "./locales/en/shell.json"
      },
      {
        "id": "i18n.shell",
        "locale": "de",
        "resources": "./locales/de/shell.json"
      }
    ],
    "settings": [
      {
        "id": "language",
        "title": "语言",
        "icon": "globe",
        "component": "LanguageSettings",
        "saveMode": "manual",
        "order": 999
      }
    ]
  }
}
