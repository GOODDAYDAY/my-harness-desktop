{
  "id": "read-claude-md",
  "version": "0.1.0",
  "tier": "official",
  "displayName": "CLAUDE.md 自动加载",
  "extensions": {
    "pi": "./pi-extension"
  },
  "description": "内置内核扩展随插件启停同步：会话启动自动发现全局（~/.claude/）与项目级（cwd 逐级向上）CLAUDE.md 指令文件，以隐藏消息注入会话上下文；卸载即停止同步。",
  "tags": [
    "productivity"
  ],
  "contributes": {
    "languages": [
      {
        "id": "read-claude-md.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "read-claude-md.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "read-claude-md.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "read-claude-md.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
