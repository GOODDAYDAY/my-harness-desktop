{
  "id": "session-colors",
  "version": "0.5.0",
  "tier": "official",
  "displayName": "会话图钉",
  "description": "给会话行与会话消息钉带颜色的图钉，任意位置，跟随宿主移动",
  "tags": [
    "session"
  ],
  "renderer": "./renderer/index.tsx",
  "contributes": {
    "sidePanel": [
      {
        "id": "session-colors",
        "label": "图钉",
        "icon": "pin",
        "component": "SessionColorsPanel",
        "order": 80
      }
    ],
    "messageActions": [
      {
        "id": "contentPin",
        "component": "ContentPinAction",
        "placement": "left",
        "when": { "role": ["user", "assistant"] },
        "order": 30
      }
    ],
    "languages": [
      {
        "id": "session-colors.pinColors",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/pinColors.json"
      },
      {
        "id": "session-colors.pinColors",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/pinColors.json"
      },
      {
        "id": "session-colors.pinColors",
        "locale": "en",
        "resources": "./locales/en/pinColors.json"
      },
      {
        "id": "session-colors.pinColors",
        "locale": "de",
        "resources": "./locales/de/pinColors.json"
      }
    ]
  }
}
