{
  "id": "session-bookmarks",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "会话分叉与收藏",
  "description": "会话分叉(fork)与会话收藏(快照)管理——插点功能的唯一宿主",
  "tags": [
    "session"
  ],
  "renderer": "./renderer/index.tsx",
  "dependsOn": [
    "timeline",
    "session-tree"
  ],
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "sidePanel": [
      {
        "id": "bookmarks",
        "label": "收藏",
        "icon": "bookmark",
        "component": "BookmarksTab",
        "order": 5,
        "revealOn": "bookmarks:addRequested"
      }
    ],
    "messageActions": [
      {
        "id": "fork",
        "component": "ForkAction",
        "placement": "left",
        "when": {
          "role": [
            "assistant"
          ],
          "settled": true
        },
        "order": 18
      },
      {
        "id": "bookmark",
        "component": "BookmarkAction",
        "placement": "left",
        "when": {
          "role": [
            "assistant"
          ],
          "settled": true
        },
        "order": 20
      }
    ],
    "languages": [
      {
        "id": "session-bookmarks.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      },
      {
        "id": "session-bookmarks.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "session-bookmarks.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "session-bookmarks.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "de",
        "resources": "./locales/de/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "en",
        "resources": "./locales/en/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/bookmarks.json"
      },
      {
        "id": "session-bookmarks.sidePanel",
        "locale": "de",
        "resources": "./locales/de/sidePanel.json"
      },
      {
        "id": "session-bookmarks.sidePanel",
        "locale": "en",
        "resources": "./locales/en/sidePanel.json"
      },
      {
        "id": "session-bookmarks.sidePanel",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/sidePanel.json"
      },
      {
        "id": "session-bookmarks.sidePanel",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/sidePanel.json"
      }
    ]
  }
}
