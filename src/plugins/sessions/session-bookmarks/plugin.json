{
  "id": "session-bookmarks",
  "version": "0.1.0",
  "displayName": "会话收藏",
  "description": "会话书签管理",
  "tags": [
    "session"
  ],
  "renderer": "./renderer/index.tsx",
  "dependsOn": [
    "session-tree"
  ],
  "permissions": [
    "fs:project"
  ],
  "contributes": {
    "sidePanel": [
      {
        "id": "bookmarks",
        "label": "收藏",
        "icon": "bookmark",
        "component": "BookmarksTab",
        "order": 5
      }
    ],
    "messageActions": [
      {
        "id": "bookmark",
        "labelKey": "bookmarks.actionLabel",
        "icon": "bookmark",
        "when": {
          "role": "user"
        }
      }
    ],
    "languages": [
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "en",
        "resources": "./locales/en/bookmarks.json"
      },
      {
        "id": "session-bookmarks.bookmarks",
        "locale": "de",
        "resources": "./locales/de/bookmarks.json"
      }
    ]
  }
}
