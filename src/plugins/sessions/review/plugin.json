{
  "id": "review",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "评论",
  "description": "选中会话流里的文字片段,附上意见,随下一条消息一次性发给模型",
  "tags": ["conversation"],
  "renderer": "./renderer/index.tsx",
  "dependsOn": ["timeline"],
  "contributes": {
    "languages": [
      { "id": "review.shell", "locale": "zh-CN", "resources": "./locales/zh-CN/shell.json" },
      { "id": "review.shell", "locale": "en", "resources": "./locales/en/shell.json" },
      { "id": "review.shell", "locale": "zh-TW", "resources": "./locales/zh-TW/shell.json" },
      { "id": "review.shell", "locale": "de", "resources": "./locales/de/shell.json" },
      { "id": "review.settings", "locale": "zh-CN", "resources": "./locales/zh-CN/settings.json" },
      { "id": "review.settings", "locale": "en", "resources": "./locales/en/settings.json" },
      { "id": "review.settings", "locale": "zh-TW", "resources": "./locales/zh-TW/settings.json" },
      { "id": "review.settings", "locale": "de", "resources": "./locales/de/settings.json" }
    ],
    "settingsGroups": [
      {
        "id": "reviewBasket",
        "titleKey": "settings.groupReview",
        "order": 30,
        "fields": [
          { "key": "reviewBasketVisibleCount", "type": "int", "default": 5, "titleKey": "settings.reviewBasketVisibleCount", "descKey": "settings.reviewBasketVisibleCountDesc", "options": [3, 5, 8, 10] }
        ]
      }
    ],
    "blockRenderers": [
      {
        "id": "review-aux",
        "block": "auxBlock",
        "names": ["review"],
        "component": "ReviewAuxBlock",
        "order": 100
      }
    ]
  }
}
