{
  "id": "goal",
  "version": "0.1.0",
  "tier": "official",
  "displayName": "目标",
  "description": "goal 能力：内核无关的同会话持久目标（set_goal/achieve_goal）+ 壳层续跑驱动",
  "tags": [
    "session"
  ],
  "renderer": "./renderer/index.tsx",
  "piExtension": "./pi-extension",
  "dshExtension": "./dsh-extension",
  "contributes": {
    "blockRenderers": [
      {
        "id": "goal",
        "block": "toolCall",
        "names": ["set_goal", "achieve_goal"],
        "component": "GoalCard"
      },
      {
        "id": "goal-round",
        "block": "auxBlock",
        "names": ["goal_round"],
        "component": "GoalRoundCard",
        "order": 90
      }
    ],
    "composerTop": [
      {
        "id": "goal",
        "component": "GoalBar",
        "order": 40
      }
    ],
    "settingsGroups": [
      {
        "id": "goal",
        "titleKey": "goal.settings.group",
        "order": 50,
        "fields": [
          {
            "key": "goal.maxRounds",
            "type": "int",
            "default": 1000,
            "titleKey": "goal.settings.maxRounds",
            "descKey": "goal.settings.maxRoundsDesc",
            "options": [100, 500, 1000, 5000]
          }
        ]
      }
    ],
    "languages": [
      { "id": "goal.zh-CN", "locale": "zh-CN", "resources": "./locales/zh-CN/goal.json" },
      { "id": "goal.en", "locale": "en", "resources": "./locales/en/goal.json" },
      { "id": "goal.zh-TW", "locale": "zh-TW", "resources": "./locales/zh-TW/goal.json" },
      { "id": "goal.de", "locale": "de", "resources": "./locales/de/goal.json" }
    ]
  }
}
