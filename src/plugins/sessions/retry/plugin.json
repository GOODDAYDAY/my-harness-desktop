{
  "id": "retry",
  "version": "0.1.0",
  "displayName": "重试",
  "description": "消息重试按钮:从任意 assistant/tool 节点 fork 并重新生成",
  "tags": ["conversation"],
  "renderer": "./renderer/index.tsx",
  "dependsOn": ["timeline"],
  "contributes": {
    "messageActions": [
      {
        "id": "retry",
        "labelKey": "shell.retry",
        "icon": "rotate-ccw",
        "placement": "left",
        "when": { "role": ["assistant"] },
        "order": 50
      }
    ],
    "languages": [
      {
        "id": "retry.shell",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/shell.json"
      },
      {
        "id": "retry.shell",
        "locale": "en",
        "resources": "./locales/en/shell.json"
      },
      {
        "id": "retry.shell",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/shell.json"
      },
      {
        "id": "retry.shell",
        "locale": "de",
        "resources": "./locales/de/shell.json"
      }
    ]
  }
}
