{
  "id": "timeline",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "时间线",
  "description": "中区会话消息流渲染:消息气泡、思考块、工具调用、分隔线(消费 session-store 中性消息)",
  "tags": [
    "conversation"
  ],
  "renderer": "./renderer/index.tsx",
  "protected": true,
  "dependsOn": [
    "pi-model-manager",
    "message-blocks",
    "stickers"
  ],
  "contributes": {
    "mainView": [
      {
        "id": "timeline",
        "component": "TimelineView",
        "order": 100
      }
    ],
    "titlebar": [
      {
        "id": "session-stats",
        "component": "SessionStatsTitlebar",
        "order": 50
      }
    ],
    "settingsGroups": [
      {
        "id": "sessionFlow",
        "titleKey": "settings.groupSessionFlow",
        "order": 10,
        "fields": [
          { "key": "defaultThinkingLevel", "type": "enum", "default": "high", "titleKey": "settings.defaultThinkingLevel", "descKey": "settings.defaultThinkingLevelDesc",
            "options": [
              { "value": "off", "labelKey": "shell.levelOff" },
              { "value": "minimal", "labelKey": "shell.levelMinimal" },
              { "value": "low", "labelKey": "shell.levelLow" },
              { "value": "medium", "labelKey": "shell.levelMedium" },
              { "value": "high", "labelKey": "shell.levelHigh" },
              { "value": "xhigh", "labelKey": "shell.levelXhigh" }
            ] },
          { "key": "composerApplyTiming", "type": "enum", "default": "onSend", "titleKey": "settings.composerApplyTiming", "descKey": "settings.composerApplyTimingDesc",
            "options": [
              { "value": "onSend", "labelKey": "settings.applyOnSend" },
              { "value": "immediate", "labelKey": "settings.applyImmediate" }
            ] },
          { "key": "composerMaxLines", "type": "int", "default": 10, "titleKey": "settings.composerMaxLines", "descKey": "settings.composerMaxLinesDesc", "options": [5, 10, 15, 20, 30] },
          { "key": "userBubbleMaxLines", "type": "int", "default": 10, "titleKey": "settings.userBubbleMaxLines", "descKey": "settings.userBubbleMaxLinesDesc", "options": [5, 10, 15, 20, 30] },
          { "key": "showHiddenMessages", "type": "boolean", "default": false, "titleKey": "settings.showHiddenMessages", "descKey": "settings.showHiddenMessagesDesc" },
          { "key": "timelineCollapseDefault", "type": "boolean", "default": true, "titleKey": "settings.timelineCollapseDefault", "descKey": "settings.timelineCollapseDefaultDesc" }
        ]
      }
    ],
    "messageActions": [
      {
        "id": "copy",
        "component": "CopyAction",
        "placement": "left",
        "order": 10
      },
      {
        "id": "bookmark",
        "component": "BookmarkAction",
        "placement": "left",
        "when": { "role": ["assistant"] },
        "order": 20
      },
      {
        "id": "rewind",
        "component": "RewindAction",
        "placement": "right",
        "when": { "role": ["user"] },
        "order": 10
      }
    ],
    "languages": [
      {
        "id": "timeline.timeline",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/timeline.json"
      },
      {
        "id": "timeline.timeline",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/timeline.json"
      },
      {
        "id": "timeline.timeline",
        "locale": "en",
        "resources": "./locales/en/timeline.json"
      },
      {
        "id": "timeline.timeline",
        "locale": "de",
        "resources": "./locales/de/timeline.json"
      },
      {
        "id": "timeline.shell",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/shell.json"
      },
      {
        "id": "timeline.shell",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/shell.json"
      },
      {
        "id": "timeline.shell",
        "locale": "en",
        "resources": "./locales/en/shell.json"
      },
      {
        "id": "timeline.shell",
        "locale": "de",
        "resources": "./locales/de/shell.json"
      },
      {
        "id": "timeline.settings",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/settings.json"
      },
      {
        "id": "timeline.settings",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/settings.json"
      },
      {
        "id": "timeline.settings",
        "locale": "en",
        "resources": "./locales/en/settings.json"
      },
      {
        "id": "timeline.settings",
        "locale": "de",
        "resources": "./locales/de/settings.json"
      },
      {
        "id": "timeline.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "timeline.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "timeline.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "timeline.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
