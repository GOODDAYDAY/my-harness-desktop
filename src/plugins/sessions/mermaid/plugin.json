{
  "id": "mermaid",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "Mermaid 图",
  "description": "会话流 mermaid 围栏代码块渲染成图(本地渲染,动态加载)",
  "tags": ["conversation"],
  "renderer": "./renderer/index.tsx",
  "contributes": {
    "codeBlockRenderers": [
      { "id": "mermaid", "languages": ["mermaid"], "fileExtensions": ["mmd", "mermaid"], "component": "MermaidCodeBlock" }
    ],
    "languages": [
      { "id": "mermaid.plugin", "locale": "zh-CN", "resources": "./locales/zh-CN/plugin.json" },
      { "id": "mermaid.plugin", "locale": "zh-TW", "resources": "./locales/zh-TW/plugin.json" },
      { "id": "mermaid.plugin", "locale": "en", "resources": "./locales/en/plugin.json" },
      { "id": "mermaid.plugin", "locale": "de", "resources": "./locales/de/plugin.json" }
    ]
  }
}
