{
  "id": "theme-manager",
  "version": "0.4.9",
  "tier": "official",
  "displayName": "Theme Manager",
  "description": "主题选择、字体偏好、字号调整",
  "contributes": {
    "settings": [
      {
        "id": "theme",
        "title": "主题",
        "icon": "palette",
        "component": "ThemeSettings",
        "configFile": "~/.pi-desktop/config/config.json",
        "saveMode": "manual",
        "order": 2
      }
    ],
    "languages": [
      {
        "id": "theme-manager.theme",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/theme.json"
      },
      {
        "id": "theme-manager.theme",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/theme.json"
      },
      {
        "id": "theme-manager.theme",
        "locale": "en",
        "resources": "./locales/en/theme.json"
      },
      {
        "id": "theme-manager.theme",
        "locale": "de",
        "resources": "./locales/de/theme.json"
      },
      {
        "id": "theme-manager.settings",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/settings.json"
      },
      {
        "id": "theme-manager.settings",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/settings.json"
      },
      {
        "id": "theme-manager.settings",
        "locale": "en",
        "resources": "./locales/en/settings.json"
      },
      {
        "id": "theme-manager.settings",
        "locale": "de",
        "resources": "./locales/de/settings.json"
      },
      {
        "id": "theme-manager.plugin",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/plugin.json"
      },
      {
        "id": "theme-manager.plugin",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/plugin.json"
      },
      {
        "id": "theme-manager.plugin",
        "locale": "en",
        "resources": "./locales/en/plugin.json"
      },
      {
        "id": "theme-manager.plugin",
        "locale": "de",
        "resources": "./locales/de/plugin.json"
      }
    ]
  }
}
