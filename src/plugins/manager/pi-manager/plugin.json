{
  "id": "pi-manager",
  "version": "0.9.0",
  "tier": "official",
  "displayName": "Pi Manager",
  "description": "pi 内核管理:内核版本 + 配置 + 拓展 + 模型(一个入口三个 TAB)",
  "contributes": {
    "settings": [
      {
        "id": "pi",
        "title": "Pi",
        "icon": "pi",
        "order": 0,
        "tabs": [
          {
            "id": "pi-kernel",
            "title": "Pi",
            "component": "PiManagerPage",
            "configFile": "~/.pi/agent/settings.json",
            "configMerge": "deep"
          },
          {
            "id": "pi-ext",
            "title": "PI 拓展",
            "component": "ExtensionManagerPage",
            "saveMode": "manual"
          },
          {
            "id": "pi-models",
            "title": "模型",
            "component": "ModelManagerPage",
            "saveMode": "manual"
          }
        ]
      }
    ],
    "languages": [
