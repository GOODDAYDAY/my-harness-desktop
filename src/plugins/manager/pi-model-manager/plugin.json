    "settings": [
      {
        "id": "models",
        "title": "模型",
        "icon": "sliders-horizontal",
        "component": "ModelManagerPage",
        "configFile": "~/.pi/agent/models.json",
        "configMerge": "replace",
        "order": 7
      }
    ],
    "languages": [
      {
        "id": "pi-model-manager.models",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/models.json"
      },
      {
        "id": "pi-model-manager.models",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/models.json"
      },
      {
        "id": "pi-model-manager.models",
        "locale": "en",
        "resources": "./locales/en/models.json"
      },
      {
        "id": "pi-model-manager.models",
        "locale": "de",
        "resources": "./locales/de/models.json"
      },
      {
        "id": "pi-model-manager.settings",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/settings.json"
      },
      {
        "id": "pi-model-manager.settings",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/settings.json"
      },
      {
        "id": "pi-model-manager.settings",
        "locale": "en",
        "resources": "./locales/en/settings.json"
      },
      {
        "id": "pi-model-manager.settings",
        "locale": "de",
