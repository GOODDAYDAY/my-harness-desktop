{
  "id": "theme-chatgpt",
  "version": "0.9.0",
  "displayName": "ChatGPT Theme",
  "description": "ChatGPT 风格主题",
  "tokenSchemaVersion": "^1.0",
  "contributes": {
    "themes": [
      {
        "id": "chatgpt-dark",
        "name": "ChatGPT Dark",
        "base": "dark",
        "tokens": {
          "color.bg": "#212121",
          "color.fg": "#ececec",
          "color.surface": "#2f2f2f",
          "color.surface-fg": "#ececec",
          "color.primary": "#ececec",
          "color.primary-fg": "#212121",
          "color.accent.success": "#34d399",
          "color.accent.warning": "#facc15",
          "color.accent.error": "#f87171",
          "color.accent.danger": "#f87171",
          "color.border": "rgba(255,255,255,0.08)",
          "color.muted": "#9b9b9b",
          "color.chrome": "#171717",
          "color.list.selected.bg": "#2f2f2f",
          "color.list.selected.border": "transparent",
          "spacing.xs": "10px",
          "spacing.sm": "16px",
          "spacing.md": "20px",
          "spacing.lg": "28px",
          "spacing.xl": "40px",
          "radius.sm": "8px",
          "radius.md": "12px",
          "radius.lg": "16px",
          "shadow.sm": "0 1px 2px rgba(0,0,0,0.2)",
          "shadow.md": "0 4px 16px rgba(0,0,0,0.3)",
          "shadow.lg": "0 8px 32px rgba(0,0,0,0.4)",
          "motion.duration.fast": "140ms",
          "motion.duration.normal": "240ms",
          "motion.duration.slow": "320ms",
          "divider.color": "rgba(255,255,255,0.12)",
          "divider.width": "1px",
          "divider.inset": "12px"
        }
      }
    ]
  }
}
