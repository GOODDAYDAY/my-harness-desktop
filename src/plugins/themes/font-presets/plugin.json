{
  "id": "font-presets",
  "version": "0.1.0",
  "tier": "official",
  "displayName": "Font Presets",
  "description": "字体预设:等宽/英文/中文三组字体选项 + 各语言文案。字体栈是会变的内容,从圆心外推为插件贡献——新增字体选项 = 改本 manifest 一行。",
  "protected": true,
  "contributes": {
    "fontPresets": [
      {
        "id": "jetbrains",
        "category": "mono",
        "labelKey": "fontPresets.mono.jetbrains",
        "stack": "\"JetBrains Mono\", \"SF Mono\", \"Menlo\", monospace"
      },
      {
        "id": "fira",
        "category": "mono",
        "labelKey": "fontPresets.mono.fira",
        "stack": "\"Fira Code\", \"JetBrains Mono\", monospace"
      },
      {
        "id": "cascadia",
        "category": "mono",
        "labelKey": "fontPresets.mono.cascadia",
        "stack": "\"Cascadia Code\", \"Cascadia Mono\", monospace"
      },
      {
        "id": "sfmono",
        "category": "mono",
        "labelKey": "fontPresets.mono.sfmono",
        "stack": "\"SF Mono\", \"Menlo\", monospace"
      },
      {
        "id": "menlo",
        "category": "mono",
        "labelKey": "fontPresets.mono.menlo",
        "stack": "\"Menlo\", \"Consolas\", monospace"
      },
      {
        "id": "system-mono",
        "category": "mono",
        "labelKey": "fontPresets.mono.systemMono",
        "stack": "ui-monospace, \"SF Mono\", monospace"
      },
      {
        "id": "system",
        "category": "english",
        "labelKey": "fontPresets.english.system",
