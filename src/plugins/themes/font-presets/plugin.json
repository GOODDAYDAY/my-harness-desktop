    "languages": [
      {
        "id": "font-presets.fonts",
        "locale": "zh-CN",
        "resources": "./locales/zh-CN/fonts.json"
      },
      {
        "id": "font-presets.fonts",
        "locale": "zh-TW",
        "resources": "./locales/zh-TW/fonts.json"
      },
      {
        "id": "font-presets.fonts",
        "locale": "en",
        "resources": "./locales/en/fonts.json"
      },
      {
        "id": "font-presets.fonts",
        "locale": "de",
        "resources": "./locales/de/fonts.json"
