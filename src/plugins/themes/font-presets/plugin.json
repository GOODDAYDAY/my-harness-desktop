      },
      {
        "id": "georgia",
        "category": "english",
        "labelKey": "fontPresets.english.georgia",
        "stack": "Georgia, \"Times New Roman\""
      },
      {
        "id": "times",
        "category": "english",
        "labelKey": "fontPresets.english.times",
        "stack": "\"Times New Roman\", Times"
      },
      {
        "id": "palatino",
        "category": "english",
        "labelKey": "fontPresets.english.palatino",
        "stack": "Palatino, \"Palatino Linotype\", \"Book Antiqua\""
      },
      {
        "id": "garamond",
        "category": "english",
        "labelKey": "fontPresets.english.garamond",
        "stack": "Garamond, \"EB Garamond\", \"Times New Roman\""
      },
      {
        "id": "comic-sans",
        "category": "english",
        "labelKey": "fontPresets.english.comicSans",
        "stack": "\"Comic Sans MS\", \"Comic Sans\""
      },
      {
        "id": "heiti",
        "category": "chinese",
        "labelKey": "fontPresets.chinese.heiti",
        "stack": "\"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\"",
        "generic": "sans-serif"
      },
      {
        "id": "songti",
        "category": "chinese",
        "labelKey": "fontPresets.chinese.songti",
        "stack": "\"Songti SC\", \"STSong\", \"SimSun\", \"Noto Serif CJK SC\"",
        "generic": "serif"
      },
      {
        "id": "kaiti",
        "category": "chinese",
        "labelKey": "fontPresets.chinese.kaiti",
        "stack": "\"Kaiti SC\", \"STKaiti\", \"KaiTi\", \"Noto Serif CJK SC\"",
        "generic": "serif"
      },
      {
        "id": "xingkai",
        "category": "chinese",
        "labelKey": "fontPresets.chinese.xingkai",
        "stack": "\"Xingkai SC\", \"STXingkai\", \"Noto Serif CJK SC\"",
