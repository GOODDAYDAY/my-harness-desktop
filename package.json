{
  "name": "pi-desktop",
  "version": "0.4.9",
  "description": "VSCode 式薄壳桌面应用：core 只提供机制，一切功能是插件，pi 底座是被管理对象",
  "author": {
    "name": "earendil-works"
  },
  "homepage": "https://pi.dev",
  "license": "MIT",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run.cjs electron-vite dev",
    "build": "electron-vite build",
    "preview": "node scripts/run.cjs electron-vite preview",
    "start": "node scripts/run.cjs electron . --remote-debugging-port=9222",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/plugins/ --max-warnings=0",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "patch:electron": "node assets/scripts/patch-electron.cjs",
    "postinstall": "node node_modules/electron/install.js && node assets/scripts/patch-electron.cjs && node assets/scripts/patch-pi-rpc.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo/record.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@viz-js/viz": "^3.29.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dot-prop": "^10.2.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.1",
    "plantuml-encoder": "^1.4.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-complex-tree": "^2.6.2",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-virtuoso": "^4.18.11",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "~5.9",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/deepmerge": "^2.1.0",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "puppeteer-core": "^25.3.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
