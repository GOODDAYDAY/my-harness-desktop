{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "VSCode 式薄壳桌面应用：core 只提供机制，一切功能是插件，pi 底座是被管理对象",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "start": "env -u ELECTRON_RUN_AS_NODE electron . --remote-debugging-port=9222"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/tar": "^6.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dot-prop": "^10.2.0",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-complex-tree": "^2.6.2",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-virtuoso": "^4.18.11",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "~5.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/deepmerge": "^2.1.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-vite": "^2.3.0",
    "puppeteer-core": "^25.3.0",
    "vite": "^5.4.0"
  }
}
