{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "VSCode 式薄壳桌面应用：core 只提供机制，一切功能是插件，pi 底座是被管理对象",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "start": "env -u ELECTRON_RUN_AS_NODE electron . --remote-debugging-port=9222",
    "test:e2e": "node tests/e2e/settings-page.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dot-prop": "^10.2.0",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-complex-tree": "^2.6.2",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/deepmerge": "^2.1.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-vite": "^2.3.0",
    "puppeteer-core": "^25.3.0",
    "vite": "^5.4.0"
  }
}
